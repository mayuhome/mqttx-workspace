    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "mqtt": "^5.15.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@changesets/cli": "^3.0.2",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
