  "scripts": {
    "ng": "ng",
    "start": "ng serve demo-app",
    "build": "turbo run build",
    "build:lib": "ng build ngx-mqttx",
    "watch:lib": "ng build ngx-mqttx --watch --configuration development",
    "test": "turbo run test",
    "test:lib": "ng test ngx-mqttx",
    "test:lib:ci": "ng test ngx-mqttx --no-watch",
    "build:demo": "ng build demo-app",
    "test:demo": "ng test demo-app --no-watch",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:alpha": "node scripts/release.js prerelease --preid=alpha",
    "release:beta": "node scripts/release.js prerelease --preid=beta"
  },
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
